{
  "name": "ytt-schema-docs",
  "version": "1.0.0",
  "scripts": {
    "build": "npm run generate && NODE_ENV=production webpack",
    "pages": "npm run build && cp dist/index.html dist/bundle.js dist/bundle.js.LICENSE.txt dist/main.css docs/",
    "start": "npm run generate && NODE_ENV=development webpack serve",
    "generate": "ytt --file schema.yaml --data-values-schema-inspect --output openapi-v3 | ytt -f- --file patch.yaml > schema-openapi.yaml && openapi-generator-cli generate --generator-name html2 --template-dir src --input-spec schema-openapi.yaml --output dist --inline-schema-options SKIP_SCHEMA_REUSE=true",
    "lint": "eslint . --report-unused-disable-directives --max-warnings=0",
    "format": "prettier --write . && eslint --fix ."
  },
  "author": "Baune8D",
  "license": "MIT",
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^11.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@openapitools/openapi-generator-cli": "^2.41.0",
    "autoprefixer": "^10.6.1",
    "browserify-fs": "^1.0.0",
    "buffer": "^6.0.3",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^15.15.0",
    "mini-css-extract-plugin": "^2.10.2",
    "path-browserify": "^1.0.1",
    "postcss": "^8.5.28",
    "postcss-loader": "^8.2.1",
    "postcss-preset-env": "^10.6.1",
    "prettier": "^3.9.7",
    "prettier-plugin-organize-imports": "^4.3.0",
    "process": "^0.11.10",
    "tailwindcss": "^3.4.19",
    "util": "^0.12.5",
    "webpack": "^5.111.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.6"
  }
}
